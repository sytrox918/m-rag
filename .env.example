# Database Configuration (PostgreSQL with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# LLM Configuration (For RAG Answer Generation & Metadata Extraction)
ANSWER_PROVIDER=groq
ANSWER_MODEL=llama-3.1-70b-versatile
ANSWER_API_KEY=your_groq_api_key_here

# Vision Configuration (For Image/Slide Descriptions)
GEMINI_API_KEY=your_gemini_api_key_here

# Local AI Models (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# (Optional) Cloud Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
